    // Share website launch

    async function shareWebsite() {

      const shareData = {
        title: "Paws for Thought – We're Live!",
        text: "Exciting news! The Paws for Thought website is now live. Come and take a look!",
        url: "https://zebra-mghsv3.my.canva.site/"
      };

      try {

        if (navigator.share) {

          await navigator.share(shareData);

        } else {

          await navigator.clipboard.writeText(
            shareData.url
          );

          alert("Website link copied! Share it with your friends.");

